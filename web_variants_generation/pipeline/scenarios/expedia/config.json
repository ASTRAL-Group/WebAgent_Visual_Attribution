{
  "snapshotPath": "source/top_10_hotels_expedia.html",
  "addBaseTag": true,
  "baseHref": "https://www.expedia.com/",
  "stripScripts": true,
  "ignoreSelectors": [
    "script",
    "noscript",
    "iframe[src*='google']",
    "iframe[src*='doubleclick']",
    "iframe[src*='googlesyndication']"
  ],
  "target": {
    "selector": "[data-stid*='property-listing']",
    "fallback": ".uitk-card",
    "hotelName": "Montage Big Sky"
  },
  "titleSelectors": [
    ".uitk-text",
    ".uitk-type-300",
    ".uitk-type-400",
    ".uitk-type-500",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6"
  ],
  "input_directory": "web_variants_generation/data/expedia/html",
  "output_directory": "web_variants_generation/data/expedia",
  "target_text": "Montage Big Sky",
  "screenshot_settings": {
    "format": "png",
    "full_page": true,
    "wait_time": 2,
    "network_idle_wait": true
  },
  "coordinate_extraction": {
    "method": "html_dom",
    "confidence_threshold": 90,
    "include_images": true,
    "detection_strategies": [
      "placement_container",
      "card_size_variant",
      "text_matching"
    ]
  },
  "output_structure": {
    "screenshots_dir": "screenshots",
    "verifications_dir": "verifications",
    "coordinates_file": "coordinates.json",
    "results_file": "processing_results.json",
    "summary_file": "processing_summary.md"
  }
}

